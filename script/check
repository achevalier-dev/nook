#!/usr/bin/env bash
# Everything CI runs, runnable before you push. No arguments: every pass.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

SCRIPTS=(bin/nook install.sh bootstrap.sh script/check demo/fake-nook demo/record.sh
  pi/boot.sh pi/bin/nook-target pi/bin/nook-info pi/bin/nook-api pi/bin/nook-upgrade)
while IFS= read -r f; do SCRIPTS+=("$f"); done < <(
  find lib pi/modules test -name '*.sh' -type f | sort
)

syntax() {
  local f bad=0
  for f in "${SCRIPTS[@]}"; do
    bash -n "$f" || { echo "syntax error: $f" >&2; bad=1; }
  done
  [[ $bad == 0 ]] && echo "bash -n: ${#SCRIPTS[@]} scripts ok"
  return $bad
}

# One file at a time, and without --external-sources: every lib carries a
# `shellcheck shell=bash` directive, and following sources from the dispatcher
# makes shellcheck walk the same libraries once per case arm.
# Pinned, and preferred over whatever is installed: shellcheck findings differ
# between versions, so an unpinned lint pass means CI and a laptop disagree
# about whether the same code is clean. Docker first for exactly that reason.
SHELLCHECK_IMAGE=${SHELLCHECK_IMAGE:-koalaman/shellcheck-alpine:v0.11.0}

lint() {
  local runner=()
  if command -v docker >/dev/null && docker info >/dev/null 2>&1; then
    runner=(docker run --rm -v "$PWD:/mnt" -w /mnt "$SHELLCHECK_IMAGE" shellcheck)
  elif command -v shellcheck >/dev/null; then
    echo "note: using the shellcheck on PATH ($(shellcheck --version | awk '/version:/ {print $2}'))," >&2
    echo "      not the pinned $SHELLCHECK_IMAGE — findings may differ" >&2
    runner=(shellcheck)
  else
    echo "no docker and no shellcheck — skipping the lint pass" >&2
    return 0
  fi

  local f bad=0
  for f in "${SCRIPTS[@]}"; do
    "${runner[@]}" --severity=warning "$f" || bad=1
  done
  [[ $bad == 0 ]] && echo "shellcheck: ${#SCRIPTS[@]} scripts clean at warning severity"
  return $bad
}

# The JSON files are read by the CLI and by the Omarchy plugin loader, so a
# trailing comma is a runtime failure somewhere far from the edit.
json() {
  local f bad=0
  for f in manifest.json .claude-plugin/plugin.json; do
    python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$f" ||
      { echo "invalid JSON: $f" >&2; bad=1; }
  done
  [[ $bad == 0 ]] && echo "json: manifest and plugin manifest parse"
  return $bad
}

dispatch() { ./test/dispatch_test.sh; }
blocks() { ./test/replace_block_test.sh; }
drive() { ./test/drive_guard_test.sh; }
boot() { ./test/boot_modules_test.sh; }
multi() { ./test/nooks_test.sh; }
pipe() { ./test/boot_pipe_test.sh; }
services() { ./test/services_test.sh; }
api() { ./test/api_test.sh; }
update() { ./test/update_test.sh; }
upgrade() { ./test/upgrade_test.sh; }

case ${1-} in
  --syntax-only) syntax ;;
  --lint-only) lint ;;
  --json) json ;;
  --dispatch) dispatch ;;
  --blocks) blocks ;;
  --drive) drive ;;
  --boot) boot ;;
  --multi) multi ;;
  --pipe) pipe ;;
  --services) services ;;
  --api) api ;;
  --update) update ;;
  --upgrade) upgrade ;;
  "") syntax && lint && json && dispatch && blocks && drive && boot && multi && pipe && services && api && update && upgrade ;;
  *)
    echo "usage: script/check [--syntax-only | --lint-only | --json | --dispatch |" >&2
    echo "                     --blocks | --drive | --boot | --multi | --pipe |" >&2
    echo "                     --services | --api | --update | --upgrade]" >&2
    exit 2
    ;;
esac
