#!/usr/bin/env bash
# Adds the repository, its star count and an icon to each catalogue entry, from
# services/sources.tsv.
#
# Both are baked in here rather than fetched by the box: a page that calls
# GitHub on every load leaks what you run to a third party, needs the internet
# to render, and would spend a rate limit fifty-six times a day. The numbers
# come along with the daily catalogue pull instead.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

ICONS=${NOOK_ICONS:-https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg}
stars=0 icons=0 missing=()

while IFS=$'\t' read -r name repo icon; do
  [[ -z $name || $name == \#* ]] && continue
  dir=services/$name
  [[ -d $dir ]] || { missing+=("$name"); continue; }

  count=null
  if command -v gh >/dev/null; then
    # gh is authenticated, so this has a rate limit worth having.
    count=$(gh api "repos/$repo" --jq .stargazers_count 2>/dev/null || echo null)
    [[ $count =~ ^[0-9]+$ ]] || count=null
    [[ $count != null ]] && stars=$((stars + 1))
  fi

  tmp=$(mktemp)
  jq --arg repo "https://github.com/$repo" --argjson stars "$count" \
    '. + {repo: $repo} + (if $stars == null then {} else {stars: $stars} end)' \
    "$dir/nook.json" >"$tmp" && mv "$tmp" "$dir/nook.json"

  # Vendored, not hot-linked: the page has to render on a tailnet with no route
  # to the internet, which is exactly the situation nook is for.
  if [[ ! -f $dir/icon.svg ]] && curl -fsSL --max-time 20 "$ICONS/$icon.svg" -o "$dir/icon.svg.tmp"; then
    mv "$dir/icon.svg.tmp" "$dir/icon.svg"
    icons=$((icons + 1))
  fi
  rm -f "$dir/icon.svg.tmp"
done < services/sources.tsv

# Imported entries already carry a repo from the store they came from; anything
# on GitHub can have its stars counted the same way, and an icon is worth
# trying for by name.
for dir in services/*/; do
  name=$(basename "$dir")
  [[ -f $dir/nook.json ]] || continue

  if command -v gh >/dev/null && ! jq -e '.stars' "$dir/nook.json" >/dev/null 2>&1; then
    repo=$(jq -r '.repo // ""' "$dir/nook.json")
    if [[ $repo == https://github.com/* ]]; then
      slug=${repo#https://github.com/}
      slug=${slug%%/}
      count=$(gh api "repos/$slug" --jq .stargazers_count 2>/dev/null || echo "")
      if [[ $count =~ ^[0-9]+$ ]]; then
        tmp=$(mktemp)
        jq --argjson stars "$count" '. + {stars: $stars}' "$dir/nook.json" >"$tmp" &&
          mv "$tmp" "$dir/nook.json"
        stars=$((stars + 1))
      fi
    fi
  fi

  if [[ ! -f $dir/icon.svg ]] && curl -fsSL --max-time 15 "$ICONS/$name.svg" -o "$dir/icon.svg.tmp" 2>/dev/null; then
    mv "$dir/icon.svg.tmp" "$dir/icon.svg"
    icons=$((icons + 1))
  fi
  rm -f "$dir/icon.svg.tmp"
done

echo "stars on $stars services, $icons icons fetched"
((${#missing[@]})) && echo "in sources.tsv but not generated: ${missing[*]}" >&2
exit 0
