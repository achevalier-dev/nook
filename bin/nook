#!/usr/bin/env bash
# nook — boxes you reach from anywhere: a shared folder, a network drive, and
# containers you run from here. One directory per box under ~/.nook, so a
# Raspberry Pi and a mini PC are two nooks, not two installations.
# No daemon, no database.

set -euo pipefail

# Resolve this file through any symlinks before anything else, without GNU
# readlink -f, which macOS does not have.
_self=${BASH_SOURCE[0]}
while [[ -L $_self ]]; do
  _link=$(readlink "$_self")
  if [[ $_link == /* ]]; then _self=$_link; else _self=$(dirname "$_self")/$_link; fi
done
NOOK_BIN=$(cd -- "$(dirname -- "$_self")" && pwd)/$(basename "$_self")
ROOT=$(cd -- "$(dirname -- "$NOOK_BIN")/.." && pwd)

source "$ROOT/lib/common.sh"

usage() {
  cat <<'EOF'
nook — your Raspberry Pi, from here

  nook adopt <host>         pair with a box that has run the boot script
  nook list                 every nook adopted here, default first
  nook update               pull a newer nook and re-link it
  nook use <name>           which one the other commands talk to
  nook status [--all]       temperature, disk, containers, who holds the drive
  nook doctor [--all]       check every moving part and name the broken one

  nook mount                the shared folder at ~/nook — many machines at once
  nook attach               the drive as a real block device — one at a time
  nook eject                flush it and hand it back

  nook up [dir]             docker compose up -d, running over there
  nook push <src> [dest]    rsync into the shared folder
  nook vault init [name]    a bare git repo for an Obsidian vault
  nook ssh                  a shell on the nook
  NOOK=<name> nook …        one command against another nook

  nook help --all           every command, including the rare ones
EOF
}

usage_all() {
  cat <<'EOF'
nook — your Raspberry Pi, from here

Setup
  nook adopt [<host>] [--as <name>]     pair with a box, or re-read its config
  nook boot <host> [-- <boot flags>]    run the boot script over SSH, then adopt
  nook update                           pull a newer nook and re-link it
  nook version                          which version is installed

More than one box
  nook list                             every nook adopted here
  nook use <name>                       make it the default
  nook forget <name>                    drop it from this machine only
  NOOK=<name> nook …                    one command against another one

The shared folder — many machines at once
  nook mount                            /mnt/nook/files at ~/nook, over SFTP
  nook umount
  nook push <src> [dest]                rsync into the shared folder
  nook pull <src> [dest]                and back out again
  nook code [path]                      open the nook in VS Code over SSH

The drive — exactly one machine at a time
  nook attach                           bring it up here, refusing if held
  nook eject                            unmount, sync, disconnect
  nook disk [--local]                   transport, size, who is attached
  nook format                           erase it and make a filesystem — asks
  nook grow                             after a resize, fill the new space

Containers
  nook up [dir]                         compose up -d, on the nook
  nook down [dir]
  nook ps
  nook logs [service]

Obsidian
  nook vault init [name]                a bare git repo on the nook
  nook vault list

Everything else
  nook status [--json] [--all]          one screen, or the JSON behind it
  nook doctor [--all]                   check every moving part
  nook ssh [args…]                      a shell, or one command
  NOOK_HOME=<dir> nook …                use a different config directory
EOF
}

cmd=${1:-}
[[ $# -gt 0 ]] && shift

# Bare `nook` prints the short list; there is no menu to draw and no state to
# guess at.
[[ -z $cmd ]] && cmd=help

case $cmd in
  use | list | forget)
    source "$ROOT/lib/init.sh"
    "cmd_$cmd" "$@"
    ;;
  update)
    source "$ROOT/lib/init.sh"
    cmd_update "$ROOT"
    ;;
  adopt | boot)
    source "$ROOT/lib/adopt.sh"
    "cmd_$cmd" "$@"
    ;;
  mount | umount | unmount | push | pull | code)
    source "$ROOT/lib/folder.sh"
    [[ $cmd == unmount ]] && cmd=umount
    "cmd_$cmd" "$@"
    ;;
  attach | eject | detach | format | grow | disk)
    source "$ROOT/lib/drive.sh"
    [[ $cmd == detach ]] && cmd=eject
    "cmd_$cmd" "$@"
    ;;
  up | down | ps | logs)
    source "$ROOT/lib/containers.sh"
    "cmd_$cmd" "$@"
    ;;
  vault)
    source "$ROOT/lib/vault.sh"
    cmd_vault "$@"
    ;;
  status | doctor)
    # drive.sh for disk_device: both answers include whether the drive is
    # attached *here*, which only this machine can say.
    source "$ROOT/lib/drive.sh"
    source "$ROOT/lib/status.sh"
    "cmd_$cmd" "$@"
    ;;
  ssh)
    load_config
    exec ssh "$NOOK_HOST" "$@"
    ;;
  help | -h | --help)
    if [[ ${1:-} == --all || ${1:-} == -a ]]; then usage_all; else usage; fi
    ;;
  version | -v | --version)
    need jq
    echo "nook $(jq -r '.version // "unknown"' "$ROOT/manifest.json")"
    ;;
  *)
    usage >&2
    die "unknown command: $cmd"
    ;;
esac
