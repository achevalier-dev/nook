[Unit]
# The shared folder of one nook, mounted over SSH. Templated on the nook's name,
# so a Pi and a mini PC each get their own instance and their own mount point.
# A user unit on purpose: FUSE mounts made by root are invisible to your
# session, which is where the file manager lives.
Description=nook shared folder for %i at %h/nook/%i
Documentation=https://github.com/achevalier-dev/nook
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=%h/.nook/%i/config
ExecStartPre=/usr/bin/mkdir -p %h/nook/%i
# -f keeps sshfs in the foreground so systemd tracks the real process; without
# it the unit thinks the mount died the moment sshfs forks.
# reconnect plus the keepalives are what survives a laptop lid: without them the
# mount goes stale and every `ls` in it hangs until the next reboot.
ExecStart=/usr/bin/sshfs -f \
  -o reconnect,ServerAliveInterval=15,ServerAliveCountMax=3 \
  -o idmap=user,default_permissions,follow_symlinks \
  ${NOOK_HOST}:${NOOK_DATA}/files %h/nook/%i
ExecStop=-/usr/bin/fusermount3 -u %h/nook/%i
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
