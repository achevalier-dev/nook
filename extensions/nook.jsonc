  // ── nook ───────────────────────────────────────────────────────────────────
  // Every row runs ~/.local/bin/nook. Anything that needs sudo, a confirmation,
  // or a progress bar opens a floating terminal; the rest notifies.
  "nook": {"icon":"󰋊","label":"nook","aliases":["pi","drive","server"],"description":"Your Pi: shared folder, network drive, containers","when":"omarchy-cmd-present nook","checked":"nook status >/dev/null 2>&1"},
  "nook.unreachable": {"icon":"󰅛","label":"nook Unreachable","description":"Not answering on the tailnet","when":"! nook status >/dev/null 2>&1","action":"omarchy-launch-floating-terminal-with-presentation nook doctor"},
  "nook.status": {"icon":"󰋼","label":"Status","description":"Temperature, disk, containers, and who holds the drive","action":"omarchy-launch-floating-terminal-with-presentation nook status"},
  "nook.folder": {"icon":"󰉋","label":"Shared Folder","title":"nook Folder","description":"The lane many machines can use at once"},
  "nook.folder.mount": {"icon":"󰉐","label":"Mount","description":"Attach the shared folder at ~/nook","when":"! mountpoint -q \"$HOME/nook\"","action":"nook mount"},
  "nook.folder.open": {"icon":"󰝰","label":"Open","description":"Browse ~/nook in the file manager","when":"mountpoint -q \"$HOME/nook\"","action":"xdg-open \"$HOME/nook\""},
  "nook.folder.umount": {"icon":"󰅖","label":"Unmount","when":"mountpoint -q \"$HOME/nook\"","action":"nook umount"},
  "nook.drive": {"icon":"󰋊","label":"Network Drive","title":"nook Drive","description":"A real block device — one machine at a time"},
  "nook.drive.attach": {"icon":"󰐤","label":"Attach","description":"Bring the drive up on this machine","action":"omarchy-launch-floating-terminal-with-presentation nook attach"},
  "nook.drive.eject": {"icon":"󰇚","label":"Eject","description":"Flush and release the drive so another machine can take it","action":"omarchy-launch-floating-terminal-with-presentation nook eject"},
  "nook.drive.info": {"icon":"󰋼","label":"Drive Info","description":"Transport, size, and who is attached","action":"omarchy-launch-floating-terminal-with-presentation nook disk"},
  "nook.drive.format": {"icon":"󰗨","label":"Format Drive","description":"Erase the drive and make a fresh filesystem — asks first","action":"omarchy-launch-floating-terminal-with-presentation nook format"},
  "nook.containers": {"icon":"󰡨","label":"Containers","title":"nook Containers"},
  "nook.containers.ps": {"icon":"󰈻","label":"Running","action":"omarchy-launch-floating-terminal-with-presentation nook ps"},
  "nook.containers.logs": {"icon":"󰈙","label":"Logs","action":"omarchy-launch-floating-terminal-with-presentation nook logs"},
  "nook.vault": {"icon":"󱞁","label":"Obsidian Vaults","action":"omarchy-launch-floating-terminal-with-presentation nook vault list"},
  "nook.ssh": {"icon":"󰆍","label":"Shell","description":"A terminal on the nook","action":"omarchy-launch-floating-terminal nook ssh"},
  "nook.doctor": {"icon":"󰑓","label":"Troubleshoot","description":"Check every moving part and say which one is broken","action":"omarchy-launch-floating-terminal-with-presentation nook doctor"},
