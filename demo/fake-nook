#!/usr/bin/env bash
# The demo harness. It runs the real cmd_ functions out of lib/, with only the
# things that touch a real box replaced: the SSH connection, the block device,
# and the mount table. Every line the recording shows is printed by the same
# code a real nook runs — nothing here writes the output by hand.
#
# Two boxes are pretended into existence, a Raspberry Pi and a mini PC, because
# keeping them apart is the thing worth showing.
#
# State lives in $DEMO_STATE so a sequence of commands behaves like a session:
# attach then eject then attach again all say the right thing.

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
DEMO_STATE=${DEMO_STATE:-${TMPDIR:-/tmp}/nook-demo}
NOOK_HOME="$DEMO_STATE/home"
export NOOK_HOME DEMO_STATE
builtin command mkdir -p "$NOOK_HOME"

source "$ROOT/lib/common.sh"

state() { cat "$DEMO_STATE/$1" 2>/dev/null || echo "${2:-}"; }
set_state() { printf '%s\n' "$2" >"$DEMO_STATE/$1"; }

# --- the boxes, as far as the CLI can tell ------------------------------------
# Keyed by hostname. `nook adopt` reads /etc/nook.conf off each one and names
# the nook after what it finds there.
box_conf() {
  case $1 in
    thinkcentre)
      cat <<'EOF'
NOOK_NAME=thinkcentre
NOOK_DATA=/mnt/nook
NOOK_USER=ad
NOOK_IQN_BASE=iqn.2026-08.dev.nook
NOOK_TARGET_IQN=iqn.2026-08.dev.nook:thinkcentre
NOOK_DISK_IMG=/mnt/nook/disk.img
NOOK_TRANSPORT=iscsi
EOF
      ;;
    *)
      cat <<'EOF'
NOOK_NAME=pi
NOOK_DATA=/mnt/nook
NOOK_USER=pi
NOOK_IQN_BASE=iqn.2026-08.dev.nook
NOOK_TARGET_IQN=iqn.2026-08.dev.nook:pi
NOOK_DISK_IMG=/mnt/nook/disk.img
NOOK_TRANSPORT=nbd
EOF
      ;;
  esac
}

box_info() {
  case $1 in
    thinkcentre)
      printf '{"name":"thinkcentre","uptime":"21 days, 8 hours","temp":38.4,"load":0.44,'
      printf '"disk":{"size":4000787030016,"used":1319413953331,"avail":2681373076685},'
      printf '"containers":9,"transport":"iscsi","attached":%s}\n' "$2"
      ;;
    *)
      printf '{"name":"pi","uptime":"6 days, 4 hours","temp":47.8,"load":0.21,'
      printf '"disk":{"size":2000398934016,"used":412316860416,"avail":1588082073600},'
      printf '"containers":4,"transport":"nbd","attached":%s}\n' "$2"
      ;;
  esac
}

box_target() {
  local name=$1 holder=$2
  if [[ $name == thinkcentre ]]; then
    cat <<EOF
transport   iscsi
image       /mnt/nook/disk.img (1T allocated 214G)
target      iqn.2026-08.dev.nook:thinkcentre
portal      100.87.4.19:3260
allowed     iqn.2026-08.dev.nook:$(hostname)
attached    $holder
EOF
  else
    cat <<EOF
transport   nbd
image       /mnt/nook/disk.img (256G allocated 31G)
export      nook
portal      100.87.4.12:10809
attached    $holder
EOF
  fi
}

# Which box a call is aimed at: the ssh target during adopt, the loaded nook
# after that.
demo_box() {
  local arg
  for arg in "$@"; do
    case $arg in
      thinkcentre | pi | nook) echo "$arg"; return ;;
    esac
  done
  echo "${NOOK:-pi}"
}

remote() {
  local box holder
  box=$(demo_box "$@" "${NOOK_HOST:-}")
  holder=none
  [[ $(state "attached.$box" no) == yes || $(state "held.$box" no) == yes ]] && holder=100.87.4.31
  case "$*" in
    *"cat /etc/nook.conf"*) box_conf "$box" ;;
    *nook-info*) box_info "$box" "$([[ $holder == none ]] && echo 0 || echo 1)" ;;
    *"nook-target info"*) box_target "$box" "$holder" ;;
    *"ls -1"*vaults*) printf 'main.git\nwork.git\n' ;;
    *) : ;;
  esac
}

ssh() { remote "$@"; }

# --- this machine -------------------------------------------------------------
# Re-applied after each `source`, because lib/drive.sh defines disk_device and
# sourcing it would otherwise replace the stub with the real probe.
demo_overrides() {
  disk_device() {
    [[ $(state "attached.${NOOK:-pi}" no) == yes ]] || return 1
    echo "${NBD_DEV:-/dev/sdb}"
  }
  mounted_at() {
    [[ $(state "mounted.${NOOK:-pi}" no) == yes ]] || return 0
    echo "/run/media/you/${NOOK_LABEL:-NOOK}"
  }
  allocate_nbd() { echo /dev/nbd0; }
  write_ssh_config() { :; }
}
demo_overrides

mountpoint() { [[ $(state "folder.${NOOK:-pi}" no) == yes ]]; }
# Real directories inside the demo's own state, nothing anywhere else — the
# recording runs with HOME set to a path that does not exist.
mkdir() {
  local last=${!#}
  case $last in
    "$DEMO_STATE"*) builtin command mkdir "$@" ;;
    *) return 0 ;;
  esac
}

sudo() {
  case "$1" in
    nbd-client)
      if [[ ${2:-} == -d ]]; then
        set_state "attached.$NOOK" no
        set_state "mounted.$NOOK" no
      else
        set_state "attached.$NOOK" yes
      fi
      ;;
    iscsiadm)
      # if, not `&&`: a false guard under set -e would end the run, and the
      # discovery call reaches this with neither flag set.
      if [[ $* == *--login* ]]; then
        set_state "attached.$NOOK" yes
      elif [[ $* == *--logout* ]]; then
        set_state "attached.$NOOK" no
        set_state "mounted.$NOOK" no
      fi
      ;;
    *) : ;;
  esac
  return 0
}

udisksctl() {
  case "${1:-}" in
    mount) set_state "mounted.$NOOK" yes ;;
    unmount) set_state "mounted.$NOOK" no ;;
  esac
}

sshfs() { :; }
systemctl() { [[ ${1:-} == --user && ${2:-} == start ]] && set_state "folder.$NOOK" yes; return 0; }
fusermount3() { set_state "folder.$NOOK" no; }
rsync() { :; }
need() { :; }
notify() { echo "$1"; }

tailscale() {
  printf '{"Peer":{"a":{"HostName":"pi","Online":true,"TailscaleIPs":["100.87.4.12"]},'
  printf '"b":{"HostName":"thinkcentre","Online":true,"TailscaleIPs":["100.87.4.19"]}}}\n'
}
docker() { [[ $* == *"context inspect"* ]]; }
nbd-client() { :; }
command() {
  if [[ ${1:-} == -v ]]; then
    # The demo machine honestly has no iSCSI client, which is what `nook doctor`
    # is for — one of the two boxes needs one.
    [[ ${2:-} == iscsiadm ]] && return 1
    return 0
  fi
  builtin command "$@"
}

cmd=${1:?usage: fake-nook <command> [args…]}
shift

case $cmd in
  adopt)
    source "$ROOT/lib/adopt.sh"
    demo_overrides
    adopt_iscsi_initiator() { :; }
    adopt_docker_context() { log "docker context \"$NOOK_CONTEXT\" points at ssh://$NOOK_HOST"; }
    adopt_mount_unit() { :; }
    adopt_bookmark() { :; }
    cmd_adopt "$@"
    ;;
  use | list | forget)
    source "$ROOT/lib/init.sh"
    demo_overrides
    "cmd_$cmd" "$@"
    ;;
  mount | umount | push | pull)
    source "$ROOT/lib/folder.sh"
    demo_overrides
    "cmd_$cmd" "$@"
    ;;
  attach | eject | disk | grow)
    source "$ROOT/lib/drive.sh"
    demo_overrides
    "cmd_$cmd" "$@"
    ;;
  vault)
    source "$ROOT/lib/vault.sh"
    demo_overrides
    cmd_vault "$@"
    ;;
  status | doctor)
    source "$ROOT/lib/drive.sh"
    source "$ROOT/lib/status.sh"
    demo_overrides
    "cmd_$cmd" "$@"
    ;;
  reset) builtin command rm -rf "$DEMO_STATE"; builtin command mkdir -p "$NOOK_HOME" ;;
  # Pretend another machine took a drive, so the recording can show the guard
  # that matters most doing its job.
  hold) set_state "held.${1:-pi}" yes ;;
  release) set_state "held.${1:-pi}" no ;;
  *) die "the demo harness does not cover: $cmd" ;;
esac
