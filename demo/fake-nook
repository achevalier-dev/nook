#!/usr/bin/env bash
# The demo harness. It runs the real cmd_ functions out of lib/, with only the
# things that touch a real Pi replaced: the SSH connection, the block device,
# and the mount table. Every line the recording shows is printed by the same
# code a real nook runs — nothing here writes the output by hand.
#
# State lives in $DEMO_STATE so a sequence of commands behaves like a session:
# attach then eject then attach again all say the right thing.

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
DEMO_STATE=${DEMO_STATE:-${TMPDIR:-/tmp}/nook-demo}
NOOK_HOME="$DEMO_STATE/home"
export NOOK_HOME DEMO_STATE
mkdir -p "$NOOK_HOME"

source "$ROOT/lib/common.sh"

state() { cat "$DEMO_STATE/$1" 2>/dev/null || echo "${2:-}"; }
set_state() { printf '%s\n' "$2" >"$DEMO_STATE/$1"; }

# --- the Pi, as far as the CLI can tell ---------------------------------------
DEMO_CONF='NOOK_NAME=nook
NOOK_DATA=/mnt/nook
NOOK_USER=pi
NOOK_IQN_BASE=iqn.2026-08.dev.nook
NOOK_TARGET_IQN=iqn.2026-08.dev.nook:nook
NOOK_DISK_IMG=/mnt/nook/disk.img
NOOK_TRANSPORT=nbd'

remote() {
  case "$*" in
    *"cat /etc/nook.conf"*) printf '%s\n' "$DEMO_CONF" ;;
    *nook-info*)
      # The same shape pi/bin/nook-info emits, with the drive count following
      # whatever the demo has done so far.
      local attached=0
      [[ $(state attached no) == yes ]] && attached=1
      printf '{"name":"nook","uptime":"6 days, 4 hours","temp":47.8,"load":0.21,'
      printf '"disk":{"size":2000398934016,"used":412316860416,"avail":1588082073600},'
      printf '"containers":4,"transport":"nbd","attached":%s}\n' "$attached"
      ;;
    *"nook-target info"*)
      cat <<EOF
transport   nbd
image       /mnt/nook/disk.img (256G allocated 31G)
export      nook
portal      100.87.4.12:10809
attached    $([[ $(state attached no) == yes || $(state held no) == yes ]] && echo "100.87.4.31" || echo none)
EOF
      ;;
    *"git init --bare"*) : ;;
    *"ls -1"*vaults*) printf 'main.git\nwork.git\n' ;;
    *) : ;;
  esac
}

ssh() { remote "$@"; }

# --- this machine -------------------------------------------------------------
NBD_DEV=/dev/nbd0

# Re-applied after each `source`, because lib/drive.sh defines disk_device and
# sourcing it would otherwise replace the stub with the real probe.
demo_overrides() {
  disk_device() {
    [[ $(state attached no) == yes ]] || return 1
    echo "$NBD_DEV"
  }
  mounted_at() {
    [[ $(state mounted no) == yes ]] || return 0
    echo "/run/media/you/NOOK"
  }
}
demo_overrides

mountpoint() { [[ $(state folder no) == yes ]]; }
mkdir() { [[ ${1:-} == -p ]] && return 0; builtin command mkdir "$@"; }

sudo() {
  case "$1" in
    nbd-client)
      if [[ ${2:-} == -d ]]; then set_state attached no; set_state mounted no
      else set_state attached yes; fi
      ;;
    modprobe | blkid | tune2fs | resize2fs) : ;;
    mkfs.ext4) : ;;
    *) : ;;
  esac
}

udisksctl() {
  case "${1:-}" in
    mount) set_state mounted yes ;;
    unmount) set_state mounted no ;;
  esac
}

sshfs() { :; }
systemctl() { [[ ${1:-} == --user ]] && set_state folder yes; return 0; }
fusermount3() { set_state folder no; }
rsync() { :; }
need() { :; }
notify() { echo "$1"; }

# tailscale and docker answer for `nook doctor` only.
tailscale() {
  cat <<'EOF'
{"Peer":{"n1":{"HostName":"nook","Online":true,"TailscaleIPs":["100.87.4.12"]}}}
EOF
}
docker() { [[ $* == *"context inspect nook"* ]]; }
nbd-client() { :; }
command() {
  # Everything doctor probes for is present in the demo except the one thing
  # that honestly is not: this machine has no iSCSI client, and it does not
  # need one, because the demo nook speaks NBD.
  if [[ ${1:-} == -v ]]; then
    case ${2:-} in
      iscsiadm) return 1 ;;
      *) return 0 ;;
    esac
  fi
  builtin command "$@"
}

export -f state set_state 2>/dev/null || true

cmd=${1:?usage: fake-nook <command> [args…]}
shift

case $cmd in
  adopt)
    source "$ROOT/lib/adopt.sh"
    # The parts of adopt that edit real files on a real machine are the parts a
    # demo must not run; what it prints is unchanged.
    adopt_ssh_config() { log "ssh config updated ($HOME/.ssh/config)"; }
    adopt_iscsi_initiator() { :; }
    adopt_docker_context() { log "docker context \"nook\" points at ssh://$NOOK_HOST"; }
    adopt_mount_unit() { :; }
    adopt_bookmark() { :; }
    cmd_adopt "$@"
    ;;
  mount | umount | push | pull)
    source "$ROOT/lib/folder.sh"
    demo_overrides
    "cmd_$cmd" "$@"
    ;;
  attach | eject | disk | grow)
    source "$ROOT/lib/drive.sh"
    demo_overrides
    "cmd_$cmd" "$@"
    ;;
  vault)
    source "$ROOT/lib/vault.sh"
    demo_overrides
    cmd_vault "$@"
    ;;
  status | doctor)
    source "$ROOT/lib/drive.sh"
    source "$ROOT/lib/status.sh"
    demo_overrides
    "cmd_$cmd" "$@"
    ;;
  reset) builtin command rm -rf "$DEMO_STATE"; builtin command mkdir -p "$NOOK_HOME" ;;
  # Pretend another machine took the drive, so the recording can show the guard
  # that matters most doing its job.
  hold) set_state held yes ;;
  release) set_state held no ;;
  *) die "the demo harness does not cover: $cmd" ;;
esac
